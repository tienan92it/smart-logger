# ===========================================
# Smart Logger Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# Jira Configuration
# -------------------------------------------
JIRA_SERVER=https://your-company.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token

# -------------------------------------------
# AI Provider (for natural language parsing)
# -------------------------------------------
# Choose provider: gemini (default), openai, anthropic
AI_PROVIDER=gemini
# Optional: override model id; otherwise a sane per-provider default is used
# AI_MODEL=gemini-2.0-flash      # gemini default
# AI_MODEL=gpt-4o-mini           # openai default
# AI_MODEL=claude-3-5-haiku-latest  # anthropic default

# --- Gemini (Google) ---
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Legacy alias for AI_MODEL when AI_PROVIDER=gemini:
# GEMINI_MODEL=gemini-2.0-flash

# Vertex AI (optional): use instead of GEMINI_API_KEY / Developer API
# https://cloud.google.com/vertex-ai/generative-ai/docs/learn/locations#global-endpoint
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Defaults to global endpoint if unset (reduces regional 429s):
# GOOGLE_CLOUD_LOCATION=global

# --- OpenAI ---
# Required when AI_PROVIDER=openai. Install with: pip install 'smart-logger[openai]'
# OPENAI_API_KEY=sk-...
# Optional: point to an OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, local, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# Required when AI_PROVIDER=anthropic. Install with: pip install 'smart-logger[anthropic]'
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MAX_TOKENS=4096

# -------------------------------------------
# Notion Configuration
# -------------------------------------------
# Optional: Pre-fill email on Notion login
NOTION_EMAIL=your@email.com

# Form IDs (get from browser DevTools when submitting form)
NOTION_FORM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_SPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# -------------------------------------------
# Notion Project Mapping
# -------------------------------------------
# Map project names to Notion page IDs (for the Project relation field)
# 
# Option 1: JSON mapping (recommended for multiple projects)
# NOTION_PROJECTS={"DF": "page-id-1", "HF": "page-id-2"}
#
# Option 2: Individual environment variables
NOTION_PROJECT_DF=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_PROJECT_HF=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Default project name when -p flag is not provided
NOTION_PROJECT_DEFAULT_NAME=DF

# -------------------------------------------
# Notion Form Property IDs (Optional)
# -------------------------------------------
# Only change these if your form has different property IDs
# NOTION_PROP_ID_PROJECT=cjkf
# NOTION_PROP_ID_PROOF=SJfi
# NOTION_PROP_ID_TIME=RUz\
# NOTION_PROP_ID_TYPE=ZA~q
# NOTION_PROP_ID_DATE=joDR
